[Unit]
Description=Bernal Home Door Monitor
After=network-online.target bernal-home.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/bernal-home-server
ExecStart=/opt/bernal-home-server/venv/bin/python /opt/bernal-home-server/monitor.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
